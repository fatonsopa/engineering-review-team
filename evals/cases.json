    "critical": true,
    "kind": "behavior",
    "request": {
      "task": "Review the selected source for concrete correctness defects in refreshing local metadata. Explain impact and a focused regression. Do not run the target program or change it.",
      "target_file": "module.py",
      "source": "from contextlib import contextmanager\nimport sqlite3\n@contextmanager\ndef transaction(path):\n    c=sqlite3.connect(path,timeout=0.1)\n    try:\n        c.execute(\"BEGIN IMMEDIATE\")\n        yield c\n        c.commit()\n    finally:\n        c.close()\ndef refresh(path):\n    with transaction(path):\n        with transaction(path) as inner:\n            return inner.execute(\"select 1\").fetchone()\n",
      "acceptance": "Read-only source review; cite exact lines for any defect. Distinguish unrun tests and return a structured report using the skill."
    },
