{
  "schema_version": 1,
  "designed_hosts": [
    "chatgpt",
    "claude",
    "codex",
    "claude-code"
  ],
  "default_ai_route": "current_host_model",
  "external_cli_required": false,
  "execution_requirements": [
    "Python 3",
    "file access",
    "declared dependencies"
  ],
  "tested_host_activation": [],
  "budget_policy": "Routine testing includes bounded retries without repeated approval; preserve criteria and attempts, honor explicit hard limits, and stop on stalled progress or retry ceilings.",
  "maintenance": {
    "max_experiments": 3,
    "max_stagnant_experiments": 3,
    "max_seconds": 1800,
    "target_success_percent": 100,
    "allowed_candidate_paths": [
      "SKILL.md",
      "README.md",
      "AGENTS.md",
      "references/review_standard.md",
      "references/review_policy.md",
      "references/coordination.md",
      "references/host_setup.md",
      "config/domains.json",
      "config/documentation.json",
      "config/test_impact.json",
      "config/roles.json",
      "scripts/review_suite.py",
      "scripts/check_suite_cases.py",
      "evals/suite_cases.json",
      "assets/agents/engineering-reviewer.md",
      "assets/claude/engineering-review-lead.md",
      "assets/codex/engineering-review-lead.toml",
      "assets/claude/engineering-review-implementation.md",
      "assets/codex/engineering-review-implementation.toml",
      "assets/claude/engineering-review-architecture.md",
      "assets/codex/engineering-review-architecture.toml",
      "assets/claude/engineering-review-security.md",
      "assets/codex/engineering-review-security.toml",
      "assets/claude/engineering-review-data.md",
      "assets/codex/engineering-review-data.toml",
      "assets/claude/engineering-review-testing.md",
      "assets/codex/engineering-review-testing.toml",
      "assets/claude/engineering-review-operations.md",
      "assets/codex/engineering-review-operations.toml",
      "references/domains/implementation.md",
      "references/domains/architecture.md",
      "references/domains/security.md",
      "references/domains/data.md",
      "references/domains/testing.md",
      "references/domains/operations.md",
      "evals/v1_cases.json"
    ],
    "hard_limits": {
      "seconds": 1800,
      "invocations": 0
    }
  }
}
